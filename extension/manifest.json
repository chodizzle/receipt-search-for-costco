{
  "manifest_version": 3,
  "name": "Receipt Search for Costco",
  "short_name": "Receipt Search",
  "version": "1.0.0",
  "description": "Search every item on your Costco warehouse receipts and online orders. Unofficial; your data stays in your browser.",
  "homepage_url": "https://github.com/chodizzle/receipt-search-for-costco",
  "minimum_chrome_version": "116",
  "permissions": ["storage", "unlimitedStorage", "scripting"],
  "host_permissions": [
    "https://www.costco.com/*",
    "https://www.costco.ca/*"
  ],
  "background": { "service_worker": "background.js" },
  "action": {
    "default_title": "Search your Costco receipts",
    "default_icon": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png" }
  },
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "content_scripts": [
    {
      "matches": ["https://www.costco.com/myaccount/*", "https://www.costco.ca/myaccount/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
